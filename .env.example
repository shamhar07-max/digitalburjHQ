# Set these in the process environment; the server does not read this file automatically.
# Optional database/bootstrap locations:
# HQ_DB=/private/persistent/hq.sqlite3
# HQ_BOOTSTRAP=/private/owner_account.json
# Set only behind an HTTPS gateway preserving Host:
# HQ_SECURE_COOKIE=1
# Optional user-authorized Google Meet credentials (never commit their values):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Or use a user-authorized access token:
# GOOGLE_MEET_ACCESS_TOKEN=
# Browser OAuth callback is HQ_PUBLIC_URL/api/google/callback
# HQ_PUBLIC_URL=https://hq.digitalburj.com
# HQ_GOOGLE_TOKEN_FILE=/private/google.json
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# HQ_PRODUCT_CATALOG={"Business":{"name":"Business plan","net_cents":10000},"Academy":{"name":"Academy course","net_cents":10000},"Studio":{"name":"Studio service","net_cents":10000}}
# Prices above are examples only; configure your real eligible AED prices.
# HQ_REFUND_HOLD_DAYS=14
# ACADEMY_WEBHOOK_SECRET=
# BUSINESS_WEBHOOK_SECRET=
# STUDIO_WEBHOOK_SECRET=
